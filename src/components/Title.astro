---
// The script-over-serif heading used on every section, e.g. "Upcoming / EVENTS".
const { script, heading, level = 2, center = false } = Astro.props;
const Tag = `h${level}`;
---
<div class:list={['lock', 'flow_in_up', { center }]}>
  <span class="s flow_in_top">{script}</span>
  <Tag class="d">{heading}</Tag>
  <slot />
</div>
