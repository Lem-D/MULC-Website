---
import site from '../content/site.json';
import { url } from '../lib/url.js';
import JoinButton from './JoinButton.astro';
const { current } = Astro.props;
const links = [
  { id: 'home', label: 'Home', href: url('') },
  { id: 'about', label: 'About Us', href: url('about/') },
  { id: 'faq', label: 'FAQ', href: url('faq/') },
];
---
<header class="site">
  <div class="wrap">
    <a class="brand" href={url('')}><img src={url('images/mulc-logo.jpg')} alt="MULC logo" width="44" height="44"><span>{site.name}</span></a>
    <button class="menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mainNav">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
    <nav class="main" id="mainNav" aria-label="Main">
      {links.map((l) => (
        <a class="nl" href={l.href} aria-current={l.id === current ? 'page' : undefined}>{l.label}</a>
      ))}
      <JoinButton class="btn btn-primary btn-sm" />
    </nav>
  </div>
</header>
