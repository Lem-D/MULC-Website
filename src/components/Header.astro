---
// Site header: logo, main menu, Join button and the phone menu button. Used on every page via
// layouts/Base.astro. Logo comes from site.json `headerLogo` (falls back to the round logo + name).
// The phone menu open/close behaviour is in src/scripts/site.js ("Mobile menu").
import site from '../content/site.json';
import { url } from '../lib/url.js';
import JoinButton from './JoinButton.astro';
// `current` is the page id passed down from Base ("home", "about", ...); it marks that link with aria-current.
const { current } = Astro.props;
// To add a page to the menu, add it here and to the Menu column in Footer.astro.
const links = [
  { id: 'home', label: 'Home', href: url('') },
  { id: 'about', label: 'About Us', href: url('about/') },
  { id: 'partners', label: 'Partner with us', href: url('partners/') },
  { id: 'faq', label: 'FAQ', href: url('faq/') },
];
---
<header class="site">
  <div class="wrap">
    <a class="brand" href={url('')}>{site.headerLogo
      ? <img class="brand-lockup" src={url(site.headerLogo)} alt={site.name} width="298" height="52">
      : <><img src={url('images/mulc-logo.jpg')} alt="" width="44" height="44"><span>{site.name}</span></>}</a>
    {/* Shown in the header bar on phones only; the copy inside <nav> is the one desktops see. */}
    <JoinButton class="btn btn-primary btn-sm head-join">Join</JoinButton>
    <button class="menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mainNav">
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
    <nav class="main" id="mainNav" aria-label="Main">
      {links.map((l) => (
        <a class="nl" href={l.href} aria-current={l.id === current ? 'page' : undefined}>{l.label}</a>
      ))}
      <JoinButton class="btn btn-primary btn-sm" />
    </nav>
  </div>
</header>
