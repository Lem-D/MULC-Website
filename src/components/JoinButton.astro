---
import { url } from '../lib/url.js';
// <JoinButton />: the "Join MULC" button used in the header, hero, 404 page and elsewhere.
// Pass a `class` to restyle it and inner text to relabel it, e.g. <JoinButton class="btn btn-ghost">Join</JoinButton>.
// Every "Join MULC" button goes to the Join page, which explains the Campus Labs steps.
const { class: className = 'btn btn-primary' } = Astro.props;
---
<a class={className} href={url('join/')}><slot>Join MULC</slot></a>
