---
import '../styles/global.css';
import site from '../content/site.json';
import { url } from '../lib/url.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// Each page can pass its own link-preview text and image, so a link pasted into an
// email, LinkedIn post or chat shows a card that fits that page.
const {
  title,
  current,
  description = site.description,
  shareTitle,
  shareImage = 'images/share/home.png',
  shareImageAlt = `${site.name} logo with the words "Welcome to MacEwan Law Club"`,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const abs = (path) => new URL(path, Astro.site ?? Astro.url).href;
const pageUrl = abs(Astro.url.pathname);
const ogTitle = shareTitle ?? fullTitle;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={pageUrl}>}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={abs(url(shareImage))}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={shareImageAlt}>
  <meta property="og:locale" content="en_CA">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={abs(url(shareImage))}>
  <meta name="theme-color" content="#1A1214">
  <link rel="icon" href={url('favicon.ico')} sizes="48x48">
  <link rel="icon" href={url('favicon-32.png')} type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href={url('apple-touch-icon.png')}>
  <link rel="manifest" href={url('site.webmanifest')}>
  <link rel="sitemap" type="application/xml" href={url('sitemap.xml')}>
  <script is:inline>
    // Scroll reveals start hidden only when JavaScript runs and the visitor hasn't asked for reduced motion.
    // If site.js never loads, everything is shown after 4 seconds.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('js-motion');
      setTimeout(() => { if (!window.mulcReveal) document.documentElement.classList.remove('js-motion'); }, 4000);
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Libre+Caslon+Display&family=Pinyon+Script&display=swap">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header current={current} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
