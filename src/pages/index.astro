---
// Home page (/). Sections, top to bottom: hero + stats, Our Partners, What we Stand For,
// Upcoming Events carousel, Previous Events albums, Join band, plus the event and album popups.
//
// Content: site.json (hero, tagline, intro, standFor, joinBlurb), stats.json (via statsFor),
// events.json, sponsors.json, albums.json. The popups, carousel and "See all past events" button
// are driven by src/scripts/site.js, which reads the two JSON blocks at the bottom of this page.
import Base from '../layouts/Base.astro';
import Title from '../components/Title.astro';
import JoinButton from '../components/JoinButton.astro';
import CampusLabsButton from '../components/CampusLabsButton.astro';
import MaybeLink from '../components/MaybeLink.astro';
import site from '../content/site.json';
import { statsFor } from '../lib/stats.js';
import events from '../content/events.json';
import sponsors from '../content/sponsors.json';
import albums from '../content/albums.json';
import { url, asset } from '../lib/url.js';

// Head start for each item in a row of `cols`, so a row lands left to right rather than
// all at once. The count restarts on the next row, which is where the eye goes next.
const step = (i, cols) => `--d:${((i % cols) * 0.1).toFixed(2)}s`;

// "2026-11-05T18:00" -> "20261105T180000", for the Google Calendar link.
const gcal = (s) => s.replace(/[-:]/g, '').padEnd(15, '0');
const calendarUrl = (e) =>
  !e.dateTbd && e.start && e.end
    ? 'https://calendar.google.com/calendar/render?action=TEMPLATE' +
      `&text=${encodeURIComponent(e.title)}&dates=${gcal(e.start)}/${gcal(e.end)}` +
      `&ctz=America/Edmonton&location=${encodeURIComponent(e.location)}` +
      `&details=${encodeURIComponent(e.description)}`
    : '';

// Every event shows an RSVP button. Without its own "rsvpUrl" it opens the club's events
// on Campus Labs. Events marked "dateTbd" show a TBD disc, a "Coming soon" label and no calendar button.
const rsvpFallback = site.campusLabsUrl ? `${site.campusLabsUrl.replace(/\/$/, '')}/events` : '';
// eventData is what both the cards and the popup use, with every fallback already applied.
const eventData = events.map((e) => ({
  ...e,
  image: asset(e.image),
  rsvpUrl: e.rsvpUrl || rsvpFallback,
  calendarUrl: calendarUrl(e),
  dateText: e.dateTbd ? `Date to be announced${e.dateLabel ? ` · ${e.dateLabel}` : ''}` : e.dateLabel,
  timeText: e.dateTbd ? e.timeLabel || 'To be announced' : e.timeLabel,
  locationText: e.location || 'Location to be announced',
}));
// Album photo paths turned into real URLs for the popup.
const albumData = albums.map((a) => ({ ...a, photos: a.photos.map(asset) }));
// Team photo behind the hero. "heroImage" is the wide photo for computers and tablets,
// "heroImagePhone" an optional taller crop for phones. With the "...Widths" lists, the page loads
// resized copies named e.g. exec-2026-27-960.jpg and exec-2026-27-960.webp, so phones get a small file.
// Returns { src, srcset, webp } for a <picture>, or null when no photo is set.
const picture = (path, widths = []) => {
  if (!path) return null;
  if (!widths.length) return { src: asset(path) };
  const [, stem, ext] = path.match(/^(.*)(\.\w+)$/);
  const at = (w, e) => asset(`${stem}-${w}${e}`);
  const list = (e) => widths.map((w) => `${at(w, e)} ${w}w`).join(', ');
  return { src: at(widths.at(-1), ext), srcset: list(ext), webp: list('.webp') };
};
const hero = picture(site.heroImage, site.heroImageWidths);
const heroPhone = picture(site.heroImagePhone, site.heroImagePhoneWidths);
// Photo inside the "What we stand for" panel, sized to the panel. Falls back to the hero photo.
// A "backgroundVideo" replaces it with a full-screen video that shows through the panel.
const standImage = site.standForImage ? asset(site.standForImage) : hero?.src;
// Must match the phone breakpoint for the hero in global.css.
const phoneMedia = '(max-width: 760px)';
// Below 1200px the photo spans the full width; above it, the photo sits in about 60% on the right.
const heroSizes = '(max-width: 1199px) 100vw, 60vw';
// Close (X) icon used by both popups.
const x = '<path d="M6 6l12 12M18 6L6 18"></path>';
---
<Base current="home">
  <!-- Fixed background that the page scrolls over. It shows through the "What we Stand For" panel. -->
  {site.backgroundVideo && <div class="page-bg" aria-hidden="true">
    <video src={asset(site.backgroundVideo)} poster={asset(site.backgroundPoster) || undefined} autoplay muted loop playsinline preload="metadata"></video>
  </div>}
  <section class:list={['hero', { 'has-photo': hero }]} id="top">
    <div class="hero-main">
      <div class="hero-bg" aria-hidden="true">
        {hero
          ? <picture>
              {heroPhone?.webp && <source media={phoneMedia} type="image/webp" srcset={heroPhone.webp} sizes="100vw" />}
              {heroPhone && <source media={phoneMedia} srcset={heroPhone.srcset || heroPhone.src} sizes="100vw" />}
              {hero.webp && <source type="image/webp" srcset={hero.webp} sizes={heroSizes} />}
              <img src={hero.src} srcset={hero.srcset} sizes={heroSizes} alt="" fetchpriority="high" />
            </picture>
          : <span class="ph">[Team photo background]</span>}
      </div>
      <div class="wrap">
        <div class="hero-copy">
          <div class="flow_in_left">
            <div class="welcome">Welcome to</div>
            <h1>MacEwan<br>Law Club</h1>
          </div>
          <div class="dbl flow_in_left" style="--d:.12s"></div>
          <p class="tag flow_in_left" style="--d:.12s">{site.tagline}</p>
          <p class="lede flow_in_left" style="--d:.24s">{site.intro}</p>
          <div class="row flow_in_left" style="--d:.36s">
            <JoinButton />
            <a class="btn btn-ghost" href="#events">Upcoming events</a>
          </div>
        </div>
      </div>
    </div>
    <div class="wrap">
      <div class="stats">
        {statsFor('home').map((s, i) => <div class="stat flow_in_up" style={step(i, 4)}><b>{s.value}</b><span>{s.label}</span></div>)}
      </div>
    </div>
  </section>

  <section class="sponsors" id="sponsors" aria-labelledby="partners-h">
    <div class="wrap">
      <div class="sec-head">
        <div class="lock flow_in_up">
          <span class="s flow_in_top">Proudly supported by</span>
          <h2 class="d" id="partners-h">Our Partners</h2>
        </div>
        <a class="btn btn-ghost btn-sm fade_in" style="--d:.2s" href={url('partners/')}>Partner with us<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" set:html={'<path d="M5 12h14M13 6l6 6-6 6"></path>'}></svg></a>
      </div>
      {/* One tile per entry in sponsors.json; a tile links to the partner's site when "url" is set. */}
      <div class="sp-grid">
        {sponsors.map((s, i) => (
          <MaybeLink href={s.url} class="sp flow_in_up" style={step(i, 5)}>
            {s.logo ? <img src={asset(s.logo)} alt={s.name} loading="lazy" decoding="async" style="max-height:70px;max-width:80%;object-fit:contain"> : s.name}
          </MaybeLink>
        ))}
      </div>
    </div>
  </section>

  <section id="standfor">
    <div class="wrap">
      {/* With a photo, it is passed to CSS as --stand-img. With backgroundVideo, the panel is see-through instead. */}
      <div class:list={['stand', { 'has-photo': standImage && !site.backgroundVideo }]} style={standImage && !site.backgroundVideo ? `--stand-img:url('${standImage}')` : undefined}>
        {!site.backgroundVideo && !standImage && <span class="ph">[Background photo shows through here]</span>}
        <div class="stand-in">
          <Title script="What we" heading="Stand For">
            <p class="intro">{site.standFor.intro}</p>
          </Title>
          <div class="pillars">
            {site.standFor.pillars.map((p, i) => <div class="pillar flow_in_up" style={step(i, 3)}><b>{p.title}</b><span>{p.body}</span></div>)}
          </div>
          <a class="ulink flow_in_up" style="--d:.3s;align-self:flex-start" href={url('about/')}>Learn more about us →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="events" id="events">
    <div class="wrap">
      <div class="sec-head">
        <Title script="Upcoming" heading="Events" />
        <div class="arrows fade_in" style="--d:.2s">
          <button class="arrow" id="prevEv" aria-label="Previous events"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg></button>
          <button class="arrow" id="nextEv" aria-label="Next events"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg></button>
        </div>
      </div>
      {/* Horizontal scroll strip. Arrows and dots (#dots, built by site.js) scroll it; touch and trackpads scroll it directly. */}
      <div class="track" id="track" tabindex="0" role="region" aria-label="Upcoming events, scroll sideways">
        {eventData.map((e, i) => (
          <article class="ecard flow_in_up" style={step(i, 3)}>
            <div class="ecard-photo">
              {e.image ? <img src={e.image} alt="" width="600" height="190" loading="lazy" decoding="async"> : <img class="ecard-logo" src={asset('images/mulc-logo.jpg')} alt="" width="88" height="88" loading="lazy" decoding="async">}
              {e.dateTbd
                ? <div class="date-disc tbd" aria-label="Date to be announced">TBD</div>
                : <div class="date-disc"><small>{e.month}</small><b>{e.day}</b></div>}
            </div>
            <div class="ecard-in">
              <div class="ecard-title"><h3>{e.title}</h3>{e.dateTbd && <span class="soon-chip">Coming soon</span>}</div>
              <div class="meta">{e.dateText}{e.timeLabel && !e.dateTbd && ` · ${e.timeText}`}<br>{e.locationText}</div>
              <p>{e.summary}</p>
              <div class="ecard-actions">
                {e.rsvpUrl && <a class="btn btn-primary btn-sm" href={e.rsvpUrl} target="_blank" rel="noopener">RSVP</a>}
                {/* data-event is this event's position in eventData; site.js opens the popup for it. */}
                <button class="btn btn-outline-dk btn-sm" data-event={i}>Learn more</button>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="dots" id="dots"></div>
    </div>
  </section>

  <section class="previous" id="previous">
    <div class="wrap">
      <div style="margin-bottom:40px">
        <Title script="Previous" heading="Events"><p class="sub">Tap an event to see its photos.</p></Title>
      </div>
      {/* data-album is each album's position in albums.json; site.js opens the photo popup for it.
          On phones site.js collapses this grid to three albums until "See all past events" is tapped. */}
      <div class="albums" id="albums">
        {albums.map((a, i) => (
          <button class="album flow_in_up" style={step(i, 3)} data-album={i}>
            <span class="cover" style={a.cover ? `background:url('${asset(a.cover)}') center/cover` : undefined}>
              {!a.cover && <span class="ph">[Album cover photo]</span>}
            </span>
            <span class="cap"><span><b>{a.title}</b><small>{a.date}</small></span><em>{a.photos.length || '[00]'} photos</em></span>
          </button>
        ))}
      </div>
      <button class="btn btn-ghost btn-sm albums-more" id="albumsMore" aria-controls="albums" hidden>See all past events</button>
    </div>
  </section>

  <section class="join" id="join">
    <div class="wrap">
      <div class="join-band flow_in_bottom">
        <Title script="Ready to" heading="Join MULC?"><p>{site.joinBlurb}</p></Title>
        <div class="join-cta">
          <CampusLabsButton class="btn btn-cream" />
          <a class="join-steps" href={url('join/')}>See steps and requirements</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Event popup: filled in by src/scripts/site.js from the data below -->
  <dialog id="dlg-event" aria-labelledby="ev-title">
    <div class="dlg"><div class="dlg-in">
      <div class="dlg-hero" id="ev-hero"><img class="ph ecard-logo" src={asset('images/mulc-logo.jpg')} alt="" width="88" height="88">
        <button class="x" data-close aria-label="Close" autofocus><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" set:html={x}></svg></button>
      </div>
      <div class="dlg-body">
        <div><div class="s">Upcoming event</div><h2 id="ev-title"></h2></div>
        <div class="facts">
          <div class="fact"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#991A2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg><div><small>Date</small><span id="ev-date"></span></div></div>
          <div class="fact"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#991A2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg><div><small>Time</small><span id="ev-time"></span></div></div>
          <div class="fact"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#991A2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="10" r="2.5"></circle></svg><div><small>Location</small><span id="ev-loc"></span></div></div>
        </div>
        <p id="ev-desc"></p>
        <div class="row">
          <a class="btn btn-primary" id="ev-rsvp" target="_blank" rel="noopener">RSVP</a>
          <a class="btn btn-outline-dk" id="ev-cal" target="_blank" rel="noopener">Add to calendar</a>
        </div>
        <p class="note" id="ev-rsvp-note">RSVP opens in a new tab.</p>
      </div>
    </div></div>
  </dialog>

  <!-- Album popup -->
  <dialog id="dlg-album" aria-labelledby="al-title">
    <div class="dlg"><div class="dlg-in">
      <div class="dlg-body" style="position:relative">
        <button class="x" data-close aria-label="Close" autofocus><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" set:html={x}></svg></button>
        <div><div class="s">Photo album</div><h2 id="al-title"></h2><p class="note" id="al-date" style="margin-top:6px"></p></div>
        <div class="photos" id="photos"></div>
        <a class="btn btn-outline-dk" id="al-more" target="_blank" rel="noopener" style="align-self:flex-start">See the full album</a>
      </div>
    </div></div>
  </dialog>

  {/* Event and album data for site.js. JSON blocks don't run; site.js reads them with JSON.parse. */}
  <script type="application/json" id="events-data" set:html={JSON.stringify(eventData)}></script>
  <script type="application/json" id="albums-data" set:html={JSON.stringify(albumData)}></script>
</Base>
