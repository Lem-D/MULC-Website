---
import Base from '../layouts/Base.astro';
import Title from '../components/Title.astro';
import MaybeLink from '../components/MaybeLink.astro';
import site from '../content/site.json';
import faq from '../content/faq.json';
import documents from '../content/documents.json';
import { asset } from '../lib/url.js';
const hasEmail = site.email.includes('@');
const chevron = '<path d="M6 9l6 6 6-6"></path>';
const file = '<path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v4h4M9 12h6M9 16h6"></path>';
---
<Base title="FAQ" current="faq" description="Answers to common questions about the MacEwan Law Club, plus the club constitution.">
  <section class="faq">
    <div class="wrap">
      <div class="page-head">
        <Title script="Frequently Asked" heading="Questions" level={1} center />
        <div class="dbl fade_in" style="--d:.2s"></div>
      </div>
      <div class="paper flow_in_up" style="--d:.15s"><div class="paper-in">
        {faq.map((item, i) => (
          <details class="qa" name="faq" open={i === 0}>
            <summary><span>{item.question}</span>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#991A2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={chevron}></svg>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
        <details class="qa docs" name="faq" id="documents">
          <summary><span>Club documents</span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#991A2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={chevron}></svg>
          </summary>
          <div class="docs-in">
            <p>{documents.intro}</p>
            <div class="doc current">
              <span class="doc-ic" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={file}></svg></span>
              <div><b>{documents.current.title}<span class="cur">Current</span></b><small>{documents.current.details}</small></div>
              <a class="btn btn-outline-dk btn-sm" href={asset(documents.current.file)} target="_blank" rel="noopener">View PDF</a>
            </div>
            {documents.past.length > 0 && (
              <div class="past">
                <b>Past versions</b>
                <div class="past-links">
                  {documents.past.map((d) => <a href={asset(d.file)} target="_blank" rel="noopener">{d.label}</a>)}
                </div>
                <small>Kept for the record. The current version above is the one that applies.</small>
              </div>
            )}
          </div>
        </details>
      </div></div>
      <div class="still flow_in_bottom">
        <div><b>Still have a question?</b><span>Send us a message and an exec will get back to you.</span></div>
        <MaybeLink href={hasEmail ? `mailto:${site.email}` : ''} class="btn btn-primary">Email the club</MaybeLink>
      </div>
    </div>
  </section>
  <script is:inline>
    // Open the Club documents dropdown when someone arrives from a link to #documents.
    if (location.hash === '#documents') document.getElementById('documents').open = true;
  </script>
</Base>
